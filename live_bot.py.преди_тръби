def _пипс(долари, метал="XAUUSD"):
    """🔴 ОДИТ-67 · РАЗСТОЯНИЕТО НА ЕЗИКА НА СОБСТВЕНИКА.
    Мерено: 231 карти, НУЛА пишат пипсове. Той брои «4420→4415 = 50 пипса»,
    ботът пишеше «5.00$» — всяка карта искаше превъртане наум и вече го обърка
    веднъж («200 срещу 20»). PIP=0.10 съществуваше от началото и никога не
    стигаше до текста.
    Среброто е на друга скала: 0.001$ = 1 пипс (цена ~65$, стоп 0.54$)."""
    try:
        д = abs(float(долари))
    except Exception:
        return ""
    стъпка = PIP if метал == "XAUUSD" else 0.001
    return f"{д / стъпка:,.0f} пипса"


def _сила(мн):
    """(емоджи, дума, дял) от РЕАЛНИЯ множител на риска.

    🔴 18.08 · Размерът има ШЕСТ реални стойности (ZONE_W × МАЛЪК_РАЗМЕР_W:
    1.000 · 0.670 · 0.500 · 0.335 · 0.330 · 0.165), а картата казваше само
    «малък размер» или нищо. Изпълнено: карта при ×1.000 и карта при ×0.165 се
    различаваха с ЕДНА ДУМА — при 6× разлика в парите. Най-силният клас
    (day1: 79.9% печели от 4019 сделки) изглеждаше като най-слабия.

    Дялът Е множителят — не е измислено число, а точно колкото ботът вече
    смята. Лот НЕ се дава: собственикът каза «всеки си преценя» и е прав —
    лотът зависи от неговата сметка и брокер, които ботът не знае.
    """
    # 🔴 ПОПРАВЕНО (армия, 18.08) · ПЪРВАТА МИ ВЕРСИЯ ГРЕШЕШЕ ПО ТРИ НАЧИНА:
    #   · думите бяха за УВЕРЕНОСТ («НОРМАЛНО»), а стояха до КОЛИЧЕСТВО («⅔») —
    #     тоест «нормално» описваше НАМАЛЕН размер. Числото и думата до него не
    #     бива да си противоречат; сега всички думи са количества.
    #   · нулата нямаше дума изобщо, а тя е най-важната
    #   · четири нови емоджита (💪👍🪶🍃) за нещо, което едно (📏 мярка) върши
    _д = [(1.0, "пълен размер"), (2 / 3, "⅔ от пълния"), (1 / 2, "½ от пълния"),
          (1 / 3, "⅓ от пълния"), (1 / 6, "⅙ от пълния")]
    if мн <= 0.001:
        return "📏", "НУЛА", "не влизам"
    дял = min(_д, key=lambda t: abs(t[0] - мн))[1]
    if мн >= 0.85:
        return "📏", "ВСИЧКО", дял
    if мн >= 0.55:
        return "📏", "МНОГО", дял
    if мн >= 0.40:
        return "📏", "ПОЛОВИНАТА", дял
    if мн >= 0.25:
        return "📏", "ЛЕКО", дял
    return "📏", "ЕДВА", дял


def _пари(долари, метал="XAUUSD"):
    """ПЕЧАЛБА/ЗАГУБА НА ЕЗИКА НА СОБСТВЕНИКА.

    `_разст` мери разстояние МЕЖДУ ДВЕ НИВА и винаги е положително. Печалбата
    има ЗНАК и не се вади от две цени — затова досега шест карти пишеха само
    долари: `+7.50$/унция` (= 75 пипса), `+8.90$` (= 89), `+40.60$` (= 406).
    Собственикът брои пипсове; всеки път превърташе наум.
    """
    стъпка = PIP if метал == "XAUUSD" else 0.001
    # един и същ знак на двете места: Python дава ASCII «-», а пипсовете
    # ползват типографско «−». На една карта два различни минуса си личат.
    зн = "+" if долари >= 0 else "−"
    _п = abs(долари) / стъпка
    # 🔴 «−0 пипса (−0.05$)» се чете като нула, а не е нула. Под един пипс се
    # казва с думи — числото пак стои в долари до него.
    if abs(долари) < 1e-9:
        return "0 пипса (0.00$)"
    if _п < 1:
        return f"под 1 пипс ({зн}{abs(долари):.2f}$)"
    return f"{зн}{_п:,.0f} пипса ({зн}{abs(долари):.2f}$)"


def _разст(a, b, метал="XAUUSD", dec=2):
    """«200 пипса (20.00$)» — двете мерки на един ред, неговата отпред."""
    try:
        д = abs(float(a) - float(b))
    except Exception:
        return ""
    return f"{_пипс(д, метал)} ({д:,.{dec}f}$)"


def _sofia(iso_utc=None):
    from zoneinfo import ZoneInfo
    from datetime import datetime, timezone
    try:
        dt = datetime.fromisoformat(str(iso_utc)) if iso_utc else datetime.now(timezone.utc).replace(tzinfo=None)
        return dt.replace(tzinfo=timezone.utc).astimezone(ZoneInfo("Europe/Sofia")).strftime("%H:%M")
    except Exception:
        return "?"


def _ts_le(a, b):
    """ОДИТ-5 (L1-01): сравнение на моменти по СТОЙНОСТ, не по низ. «2026-07-29 03:00:00» и
    «2026-07-29T02:10» са един и същи ден, но като низове интервалът е по-малък от 'T' →
    старото `str(ts) <= be_since` връщаше True за цял ден и гасеше безрисковия стоп.
    При неразбираем вход връща False = «не гаси» (безопасната страна)."""
    try:
        return pd.Timestamp(a) <= pd.Timestamp(b)
    except Exception:
        return False


def _sofia_hour(iso_utc=None):
    """Софийският ЧАС като число (0-23), с лятно/зимно време. −1 при повреден вход."""
    from zoneinfo import ZoneInfo
    from datetime import datetime, timezone
    try:
        dt = datetime.fromisoformat(str(iso_utc)) if iso_utc else datetime.now(timezone.utc).replace(tzinfo=None)
        return dt.replace(tzinfo=timezone.utc).astimezone(ZoneInfo("Europe/Sofia")).hour
    except Exception:
        return -1


