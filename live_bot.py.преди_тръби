    да се ЗАПИШЕ в дневника. Дотук гейтът беше единственото важно решение на бота
    БЕЗ трайна следа: `macro` и `board` се пишат (ОДИТ-5), присъдата — не. Затова
    «защо отказа този шорт на 23.07» се четеше по археология в текста на картите,
    а картите отпреди v6.0 дори не носят причината.
    Пази се синхронно с `_advice_entry` чрез ИЗПЪЛНЯВАН тест (П18), не чрез греп."""
    if streak_n == 1:
        return "day1"
    if 2 <= streak_n <= 3:
        return "fresh"
    if streak_n == 0:
        return "mixed"
    return "stale"


def _noise(seg):
    """ОДИТ-8: клетка, чийто 95% интервал минава през нулата, е ШУМ — не ръб.
    Празни lo/hi (стар stats файл) → не съдим, връщаме False (старото поведение).

    🔴 F24 (18.08) · ВТОРО УСЛОВИЕ: клетка, която сменя ЗНАКА между епохите, също
    е шум — дори интервалът ѝ да е изцяло над нулата. Такова число описва един
    отминал пазар, не правило. Клетки без `_епохи_съгласни` (златото) не се
    засягат — `.get` връща None и условието мълчи.

    🔴 ПОПРАВКА НА СОБСТВЕНОТО МИ ТВЪРДЕНИЕ (F24г, същия ден). Писах «ВСЯКА
    сребърна лонг клетка сменя знака». На СУРОВОТО нето това е вярно само за
    `fresh` и `mixed`; `day1` (+0.0986 / +0.0019) и `stale` (+0.0397 / +0.0150)
    са положителни в ДВЕТЕ епохи, и смяната им се появява едва СЛЕД изваждането
    на спреда. Значи епохите не са независимо второ основание — за половината
    клетки са преразказ на теста за разхода. Условието остава полезно; описанието
    беше по-силно от мереното."""
    lo, hi = seg.get("lo"), seg.get("hi")
    if seg.get("_епохи_съгласни") is False:
        return True
    return lo is not None and hi is not None and lo <= 0 <= hi


def _сребро_разход(stats, notes=None):
    """F24 · СУРОВИТЕ сребърни клетки минус реалния спред.

    Златните клетки са мерени на 7.96М едноминутни бара С ДВЕТЕ СТРАНИ на спреда
    — разходът е ВЪТРЕ в числата. Сребърните са от дневни барове по средна цена,
    без спред. Да ги сравняваш направо значи да мериш двата метала с различен
    аршин. Тук се изравняват.

    Няма ли `_сурово` (стар stats файл) — клетката се оставя както си е.
    """
    sv = (stats or {}).get("silver")
    if not isinstance(sv, dict):
        return 0
    пипнати = 0
    for посока in ("long", "short"):
        клетки = sv.get(посока)
        if not isinstance(клетки, dict):
            continue
        for име, а in клетки.items():
            if not isinstance(а, dict):
                continue
            сур = а.get("_сурово")
            if not isinstance(сур, dict):
                continue
            for к in ("net", "lo", "hi"):
                v = сур.get(к)
                if v is not None:
                    а[к] = round(float(v) - СРЕБРО_СПРЕД, 4)
            # 🔴 F24б · СЪГЛАСИЕТО НА ЕПОХИТЕ СЕ СМЯТА ТУК, НЕ ВЪВ ФАЙЛА.
            # Първата ми версия го записа в JSON-а с фиксиран разход 0.03$ →
            # свалеше ли собственикът `СРЕБРО_СПРЕД` до 0.00, клетките пак
            # оставаха мъртви и «пътят назад» беше декорация. Мереното: сурово
            # day1/long дава +0.0986$ (2000-2012) и +0.0019$ (2013-2026) — двете
            # ПОЛОЖИТЕЛНИ; след 0.03$ разход стават +0.0686 и −0.0281, тоест
            # РАЗЛИЧНИ. Един и същ ред данни сменя присъдата според разхода,
            # затова разходът трябва да е вътре в сметката, не преди нея.
            еп = а.get("_епохи")
            if isinstance(еп, dict):
                _з = [float(v) - СРЕБРО_СПРЕД for v in еп.values() if v is not None]
                # само при ДВЕ измерими епохи има какво да се сравнява
                а["_епохи_съгласни"] = (len(_з) < 2
                                        or all(x > 0 for x in _з)
                                        or all(x < 0 for x in _з))
            пипнати += 1
    if пипнати and notes is not None and СРЕБРО_СПРЕД != 0.03:
        notes.append(f"🥈 сребърните клетки са смятани със спред {СРЕБРО_СПРЕД}$ "
                     f"(по подразбиране 0.03$)")
    return пипнати


def _zones(h1, direction):
    """ЗОНИТЕ ОТ ИНДИКАТОРА (FVG) — качество на входа. ОДИТ-14 (05.08).

    Индикаторът AERO PRO ги рисува от седмици; ботът не ги ползваше. Измерено на
    114813 сделки под доставената геометрия, върху допуснатите от гейта 31854:

       A · зона отдолу + чисто отгоре   32.6%   +1.998$  [+1.41 .. +2.59]  ПЕЧЕЛИ
       B · едно от двете                42.5%   +1.457$  [+0.85 .. +2.05]  ПЕЧЕЛИ
       C · нито едно                    24.9%   +0.502$  [−0.19 .. +1.19]  ШУМ
       (гейтът сам: +1.396$)

    Подредбата A>B>C е чиста — шумово разделяне не се подрежда така. Устойчива е
    и в четирите четвъртини на 22 години, и е НАЙ-СИЛНА в последната (2021-2026:
    +0.819 → +1.145). Късмет-тест: 0 от 60 случайни подмножества със същия размер
    бият резултата (средно +1.380, максимум +1.609 срещу +1.998).

    НИЩО НЕ СЕ РЕЖЕ — само размерът се степенува 1.00/0.67/0.33, при което рискът
    на собственика ОСТАВА таван: +1.396 → +1.597$ на единица риск, при 31% по-малко
    пари в риск.

    FVG (fair value gap) = празнина, оставена от бърз ход: бичи, ако low[i] > high[i-2].
    Запълва се, когато цената се върне под долния ѝ ръб. Ползва се 1-ЧАСОВАТА рамка —
    измерена като най-силната (15м и 4ч дават по-малко).
    Връща (клас, текст) — при липса на данни ('B', ''), тоест НЕУТРАЛНО, не наказва."""
    try:
        if h1 is None or len(h1) < 30:
            return "B", ""
        hi = h1["High"].values[-400:]; lo = h1["Low"].values[-400:]
        bull = bear = None                       # долен ръб на бичи · горен ръб на мечи
        for i in range(2, len(hi)):
            if lo[i] > hi[i - 2]:
                bull = float(hi[i - 2])
            if bull is not None and lo[i] < bull:
                bull = None                      # запълнена
            if hi[i] < lo[i - 2]:
                bear = float(lo[i - 2])
            if bear is not None and hi[i] > bear:
                bear = None
        if direction == "short":                 # огледално за шорт
            bull, bear = bear, bull
        have, clean = bull is not None, bear is None
        if have and clean:
            return "A", f"🟩 <b>СИЛНА ЗОНА</b> — празнина под цената ({_fmt(bull, 2)}), чисто отгоре"
        if have:
            return "B", f"🟨 зона отдолу ({_fmt(bull, 2)}), но има насрещна отгоре"
        if clean:
            return "B", "🟨 чисто отгоре, но без зона-опора отдолу"
        return "C", "🟧 без опора отдолу и с насрещна зона отгоре"
    except Exception:
        return "B", ""


ZONE_W = {"A": 1.00, "B": 0.67, "C": 0.33}      # ОДИТ-14: рискът на собственика е ТАВАН


def _fast(fast):
