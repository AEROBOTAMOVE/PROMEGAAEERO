ЛИХВИ_ИЗТОЧНИК = {}


def _rates():
    """🔴 О9 · РЕАЛНИ (DFII10) и НОМИНАЛНИ (^TNX) НЕ СА ЕДНО И СЪЩО.
    Номиналните са реалните плюс инфлационни очаквания — разлика от порядъка на
    2 процентни пункта. Бектестът, който дава числата на гейта, е мерен на
    DFII10. Падне ли FRED, ботът съди днешния ден с ДРУГА величина, отколкото
    са мерени клетките. Сега това се казва в дневника, не само в лога."""
    ЛИХВИ_ИЗТОЧНИК.clear()
    try:
        s = _fred("DFII10")
        ЛИХВИ_ИЗТОЧНИК.update(вид="реални", тикер="DFII10", резерва=False)
        print("  лихви: FRED DFII10 (реални) ✓")
    except Exception:
        df = _yf("^TNX", "2y", "1d")
        s = df["Close"] / 10.0
        ЛИХВИ_ИЗТОЧНИК.update(вид="НОМИНАЛНИ", тикер="^TNX", резерва=True)
        print("  лихви: ^TNX (резерва — НОМИНАЛНИ, не реални)")
    # О9 №2 · ЗАСТОЯЛ FRED. Публикува с закъснение и мълчи в празници; върне ли
    # серия отпреди седмици, `r - r.shift(20)` мери СТАР прозорец и изглежда
    # напълно здраво. Досега нямаше никаква проверка на възрастта.
    try:
        _посл = pd.Timestamp(s.dropna().index[-1]).tz_localize(None)
        ЛИХВИ_ИЗТОЧНИК["дни"] = int((pd.Timestamp.utcnow().tz_localize(None) - _посл).days)
    except Exception:
        ЛИХВИ_ИЗТОЧНИК["дни"] = None
    return s


