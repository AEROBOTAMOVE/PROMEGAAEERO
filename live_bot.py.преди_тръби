    _бавност = {l: i for i, (l, *_) in enumerate(TFS)}
    best = (max(board, key=lambda x: (rank[x[3]], x[2])) if РАВЕНСТВО_БЪРЗА
            else max(board, key=lambda x: (rank[x[3]], x[2], _бавност.get(x[0], 0)))) \
        if actionable else board[0]
