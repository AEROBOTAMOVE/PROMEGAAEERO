        return "\n".join(L)

    ико = "🟢" if direction == "long" else "🔴"
    глагол = "КУПИ" if direction == "long" else "ПРОДАЙ"
    _zc, _ = (zone if zone else (None, ""))
    _zw = ZONE_W.get(_zc, 1.0) if _zc else 1.0
    # 🔴 О2(в) · «ДА (малък размер)» беше САМО ДУМА. Проверено: застоял сигнал
