        # се плащаше. Сега: показва се живото, а снимката — само ако се разминава.
        _жив = None
        if isinstance(fng_live, dict):
            _жив = fng_live.get("score", fng_live.get("value"))
        elif isinstance(fng_live, (int, float)):
            _жив = fng_live
        try:
