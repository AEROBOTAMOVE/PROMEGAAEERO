    # по лота; значи числото до него трябва да е неговото.
    лот_окр = round(лот, 2)
    риск = лот_окр * дел * ед if лот_окр >= 0.01 else риск
    L = [f"{ико} {глагол} {метал} · {_sofia()}",
         f"🎯 вход <code>{_fmt(entry, dec)}</code> · "
         f"🛑 стоп <code>{_fmt(lv['sl'], dec)}</code> · "
         f"{_разст(entry, lv['sl'], sym, dec)}"
         + ("" if spot else " <i>(по бара — живата цена мълчи)</i>"),
         # 🔴 «по 1/3» стои ПРИ ЦЕЛИТЕ — там му е мястото: то казва колко се
         # прибира на всяка, а не колко се влиза. Първата ми версия го изгуби
         # заедно със стария ред за стопа.
         " · ".join(f"{n} <code>{_fmt(lv[k], dec)}</code> "
                    f"({abs(lv[k] - entry) / (PIP if sym == 'XAUUSD' else 0.001):,.0f}п)"
                    for n, k in (("1️⃣", "tp1"), ("2️⃣", "tp2"), ("3️⃣", "tp3")))
         + " · по 1/3"]
    if лот < 0.01:
        # О2(а) · «риск $27» не казва нищо, ако не знаеш от колко. Мин. лот при
        # среброто е 50 унции — при малък баланс това е далеч над целевия процент.
        _мин_р = ед * (1.0 if sym == "XAUUSD" else 50.0)
        _мин_п = (_мин_р / balance * 100.0) if balance else 0.0
        # 🔴 редът за стопа вече е на РЕД 2 на картата — тук беше вторият му дом
        if _мин_п > risk_pct + 0.05:
            L.append(f"⚠️ и с най-малката позиция (0.01 лот) рискуваш "
                     f"{_мин_п:.1f}% — над целта {risk_pct:g}%")
    else:
        # ОДИТ-35 · «риск $60» е обещание. Кодът нарочно пишеше «макс ≈»:
        # собственият тракер е записал −23.88$ при стоп −20.00 (гап).
        # Стопът пази НИВОТО, не цената.
        # 🔴 ОДИТ-41 · ЛОТЪТ ПАДА. Собственикът, 18-ия час: «не искам лотове,
        # всеки си преценя». Прав е — лотът зависи от неговата сметка, от
        # брокера и от това колко сделки държи едновременно; ботът не ги знае.
        # Остава числото, от което САМ се смята размер: колко струва стопът
