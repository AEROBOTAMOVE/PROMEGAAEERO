            _by("клетка"); _мерено(seg, src)
            # 🔴 F24 · «ИЗЧАКАЙ» обещава, че утре може да е друго. За среброто НЕ
            # може: мерено на 12858 сделки, след спред 0.03$ не оцелява нито една
            # клетка, а всяка лонг клетка сменя знака между епохите. Картата да
            # обещава промяна, която няма да дойде, е лъжа с добри намерения.
            if not is_gold:
                return "НЕ — среброто няма измерен ръб над спреда", False
            return "ИЗЧАКАЙ — прясно е, но такива случаи не носят нищо", False
        _by("клетка"); _мерено(seg, src)
        # 🔴 ОДИТ-30 · ОБЪРНАТ ЗНАК, качен от мен днес. В кода `m_l` (лонг
