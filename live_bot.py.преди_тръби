def _защо_мълчи(macro_raw, streaks, new_dir=None, стат=None):
    """ОДИТ-45 · ЗАЩО МЕРЕНОТО ПРАВИЛО МЪЛЧИ — с числата, не с усещане.

    Мерено на 1965 живи ръна: гейтът е отказал 100% от тях с `cell: mixed`,
    защото доларът пада (вдига златото), а лихвите растат (свалят го).
    Дотук това го знаеше само дневникът. Собственикът виждаше мълчащ бот.

    Връща списък от РЕДОВЕ (телеграф, един ред = едно нещо) или [] ако няма
    какво да се обясни."""
    if not isinstance(macro_raw, dict):
        return []
    д = macro_raw.get("долар"); л = macro_raw.get("лихви")
    if д is None or л is None:
        return ["⚠️ макро-фийдът мълчи · без вход, докато не се върне"]
    # знаците: числата са ВЕЧЕ обърнати (`-(промяна)`), значи ПЛЮС = добро за златото
    д_добро, л_добро = float(д) > 0, float(л) > 0
    Л = []
    Л.append(f"💵 доларът {'пада' if д_добро else 'расте'} {abs(float(д))*100:.1f}% · "
             f"{'вдига' if д_добро else 'сваля'} златото")
    Л.append(f"{'📉' if л_добро else '📈'} лихвите {'падат' if л_добро else 'растат'} "
             f"{abs(float(л)):.2f} · {'вдигат' if л_добро else 'свалят'} златото")
    if д_добро == л_добро:
        стр = int((streaks or {}).get("long" if д_добро else "short", 0))
        Л.append(f"✅ двете сочат {'НАГОРЕ' if д_добро else 'НАДОЛУ'} · "
                 f"{стр} {'ден' if стр == 1 else 'дни'} подред")
    else:
        Л.append("⏸ двете се бият · мереното правило мълчи")
        # 🔴 ОДИТ-48 · ЧИСЛОТО ИДВА ОТ КЛЕТКАТА, ПО КОЯТО СЪДИ ГЕЙТЪТ.
        # Дотук пишеше зазидано «−0.04$ (40094 сделки)» — числото от _meta,
        # което описва СЛЕТИТЕ кофи ПРЕДИ разделянето от 04.08. Гейтът обаче
        # съди по `/fresh/long/mixed/net` = −0.47$. Число на карта, което не
        # идва от клетката, по която се решава, е точно това, което този бот
        # не бива да прави.
        # 🔴 18.08 · ПОСОКАТА БЕШЕ ЗАКОВАНА НА «long». `new_dir` влизаше във
        # функцията и се изхвърляше, а клетките са РАЗЛИЧНИ:
        #     fresh/long/mixed  −0.47$
        #     fresh/short/mixed −1.30$   ← 2.8× по-лошо
        # Тоест шорт-картата цитираше чуждо, по-меко число. Това е точно
        # забраната от ОДИТ-48 осем реда по-горе, нарушена от самата поправка.
        _пос = new_dir if new_dir in ("long", "short") else "long"
        _кл = ((стат or {}).get("fresh", {}).get(_пос, {}).get("mixed", {})
               if isinstance(стат, dict) else {})
        _нет = _кл.get("net")
        if _нет is not None:
            Л.append(f"📌 в такъв пазар мереното дава "
                     f"{_пари(float(_нет))} на сделка"
                     + ("" if new_dir in ("long", "short") else " (за покупка)"))
        else:
            Л.append("📌 в такъв пазар мереното правило не носи нищо")
        # 🔴 18.08 · «КОГА». Дотук картата казваше КАКВО чака, но не КОЛКО.
        # Живо: 2552 от 2552 присъди за 15 работни дни са отказ — собственикът
        # вижда бот, който мълчи седмици, и няма как да различи «пазарът е
        # такъв» от «счупено е». Мерено на 5913 дни: подреждат се в 62.3% от
        # дните; тихите паузи са медиана 2 дни, най-дългата 30 (517 периода).
        # Числата идват от `_meta`, НЕ са заковани тук — сменят ли се при ново
        # измерване, картата ги следва.
        _ч = f"чакам {'лихвите' if д_добро else 'долара'} да тръгнат надолу" \
            if д_добро else "чакам долара да тръгне надолу"
        _т = ((стат or {}).get("_meta", {}) or {}).get("тишина_мерена") \
            if isinstance(стат, dict) else None
        # 🔴 ПОПРАВЕНО СЪЩИЯ ДЕН · ПЪРВОТО ЧИСЛО ОТГОВАРЯШЕ НА ГРЕШНИЯ ВЪПРОС.
        # Качих «паузите траят обикновено 2 дни» — това е медианата на ДЪЛЖИНАТА
        # НА ЕПИЗОД. Но картата се чете ВЪТРЕ в паузата, а тогава въпросът е
        # «колко ОЩЕ». Измерено (F32, 5913 дни, 517 епизода): оставащи от
        # произволен тих ден — медиана 4 дни, 72% свършват до седмица.
        # Дългите паузи съдържат повече дни → по-вероятно е да си в дълга.
        if isinstance(_т, dict) and _т.get("оставащи_медиана_дни"):
            Л.append(f"👁 {_ч} · още ~{_т['оставащи_медиана_дни']} дни в половината "
                     f"случаи · {_т['оставащи_до_седмица_pct']}% свършват до седмица")
        else:
            Л.append(f"👁 {_ч}")
    return Л


