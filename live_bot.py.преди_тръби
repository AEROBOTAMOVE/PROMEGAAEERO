                 if abs(float(ol.get("sl", 0)) - float(open_trade["entry"])) < 0.01 else
                 " · " + _разст(open_trade["entry"], ol["sl"], sym, dec)),
             # 🔴 БЛИЗНАК · същата функция, съседен клон: главният клон получи
             # разстояния на 18.08, този остана с голи числа. Прибраните цели
             # НЕ носят разстояние (те вече са факт), непостигнатите — да.
             " · ".join(f"{n} <code>{_fmt(ol[k], dec)}</code>"
                        + (" ✅" if hit.get(k) else
                           f" ({abs(ol[k] - open_trade['entry']) / (PIP if sym == 'XAUUSD' else 0.001):,.0f}п)")
