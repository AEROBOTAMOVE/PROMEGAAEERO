                            ensure_ascii=False) + "\n")
    print(f"УИКЕНД · слот {slot or '—'} · пратено: {sent or 'нищо (вече е пратено или извън прозорец)'}")


def main():
    ap = argparse.ArgumentParser(description=f"AERO LIVE bot {VERSION}")
