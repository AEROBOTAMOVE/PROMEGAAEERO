    # === 3) БЕЗ СПАМ + защити (Ф2 / Ф9.3) ===
    weekly = _weekly(args.weekly, date=date, notes=notes)
    last = _load_state(out / "last_sent.json", {})
    # ОДИТ-1 №7: ключът НЕ се нулираше при СМЪРТ на сетъпа. Изчезне ли бордът и се
