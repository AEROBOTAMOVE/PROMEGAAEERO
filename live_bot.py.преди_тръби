        return "\n".join(L)

    if not adv_ok:
        L = [f"⏸ БЕЗ ВХОД · {метал} "
             f"{'нагоре' if direction == 'long' else 'надолу'} · {_sofia()}",
             f"📌 {защо}",
             # 🔴 БЛИЗНАК · трети клон на същата функция. «Ако решиш сам» е точно
             # мястото, където разстоянието трябва да се вижда — човекът решава
             # сам и няма как да го извади наум от два реда по-горе.
             f"🎯 ако решиш сам: <code>{_fmt(entry, dec)}</code> · "
             f"🛑 <code>{_fmt(lv['sl'], dec)}</code> · {_разст(entry, lv['sl'], sym, dec)}",
             " · ".join(f"{n} <code>{_fmt(lv[k], dec)}</code> "
                        f"({abs(lv[k] - entry) / (PIP if sym == 'XAUUSD' else 0.001):,.0f}п)"
                        for n, k in (("1️⃣", "tp1"), ("2️⃣", "tp2"), ("3️⃣", "tp3")))]
        # 🔴 ДОТУК ТОЗИ КЛОН ВРЪЩАШЕ БЕЗ ДУМА ЗА РАЗМЕРА. Картата даваше пълен
        # план — вход, стоп, три цели — и НИТО ДУМА, че размерът е НУЛА. Точно
        # там, където е най-важно да се разбере, че не се влиза.
