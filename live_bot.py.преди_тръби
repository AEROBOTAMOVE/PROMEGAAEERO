    # 🔴 ОДИТ-62 · «ЦЯЛ ДЕН» БЕШЕ НЕВЯРНА ДУМА. Равносметката тръгва в 21:00
    # София и брои ръновете от СЪЩИЯ календарен ден по UTC — но денят на бота
    # започва в 22:00 UTC предната вечер. Мерено: 27.9% от ръновете не влизат
    # в НИКОЯ равносметка. Сега казваме какво наистина покриваме.
    try:
        _ч = sorted(str(r.get("run_utc", ""))[11:16] for r in рънове if r.get("run_utc"))
        _обхват = f"{_ч[0]}–{_ч[-1]} UTC" if _ч else "днес"
    except Exception:
        _обхват = "днес"
    L.append(f"✅ буден · {len(рънове)} проверки ({_обхват}) · {len(пратени)} съобщения")
    L.append("👁 " + ("в понеделник пак съм тук" if weekly_part else "утре пак съм тук"))
    return "\n".join(L)

