//@version=6
// ═══════════════════════════════════════════════════════════════════════════
// AERO PRO v9.1 · ПЪЛНА БЪЛГАРСКА ВЕРСИЯ
// Ясен интерфейс · автоматични TF профили · зони за евентуална покупка/продажба
// ликвидност · FVG · BOS/CHoCH/MSS · японски свещи · setup state · аларми
// ВАЖНО: Индикаторът е помощник за анализ, а не гаранция за печалба.
// ═══════════════════════════════════════════════════════════════════════════
indicator("AERO PRO v9.7 · Пазарна карта BG", overlay = true, max_bars_back = 1200,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500,
     dynamic_requests = true)

// ═══════════════════════════════════════════════════════════════════════════
// 0 · ОСНОВЕН РЕЖИМ
// ═══════════════════════════════════════════════════════════════════════════
g0 = "0 · ОСНОВЕН РЕЖИМ"
uiMode = input.string("Лесен", "Изглед", options = ["Лесен", "Стандартен", "Експертен"], group = g0,
     tooltip = "Лесен: само най-важното. Стандартен: добавя ликвидност, FVG и структура. Експертен: показва всички помощни елементи.")
tradeMode = input.string("Автоматично", "Стил на търговия", options = ["Автоматично", "Скалпинг", "Интрадей", "Суинг", "Ръчно"], group = g0,
     tooltip = "Автоматично избира йерархия според отворената графика. Ръчно използва трите таймфрейма по-долу.")
scalpVisual9 = input.string("Пълна карта", "Визуален режим 1m/5m", options = ["Скалп 1m/5m", "Пълна карта"], group = g0,
     tooltip = "Скалп 1m/5m показва само близките активни обозначения около цената. Не променя сигналите.")
confirmOnClose = input.bool(true, "Потвърждавай входовете само при затворена свещ", group = g0)
pipSize = input.float(0.10, "Размер на 1 пип", minval = 0.00001, step = 0.01, group = g0,
     tooltip = "Пример: XAUUSD често се използва 0.10; EURUSD 0.0001. Провери спецификацията на брокера.")
minRR = input.float(1.5, "Минимално риск/печалба", minval = 0.5, maxval = 10.0, step = 0.1, group = g0)

// ═══════════════════════════════════════════════════════════════════════════
// 1 · ТАЙМФРЕЙМ ЙЕРАРХИЯ
// ═══════════════════════════════════════════════════════════════════════════
g1 = "1 · ТАЙМФРЕЙМ ЙЕРАРХИЯ"
manualTf1 = input.timeframe("15", "Ръчно TF 1 · вход/кратка структура", group = g1)
manualTf2 = input.timeframe("60", "Ръчно TF 2 · основна структура", group = g1)
manualTf3 = input.timeframe("240", "Ръчно TF 3 · силни зони/контекст", group = g1)
showTfOnLabels = input.bool(true, "Показвай таймфрейма върху зоните", group = g1)

// ═══════════════════════════════════════════════════════════════════════════
// 2 · ЗОНИ ЗА ПОКУПКА / ПРОДАЖБА
// ═══════════════════════════════════════════════════════════════════════════
g2 = "2 · ЗОНИ ЗА ПОКУПКА / ПРОДАЖБА"
showZones = input.bool(true, "Показвай подкрепящи и съпротивителни зони", group = g2)
showOpportunityZones = input.bool(true, "Маркирай силните зони за евентуална покупка/продажба", group = g2)
zoneOnlyAfterSweep = input.bool(true, "Създавай зона само след обрана ликвидност", group = g2)
zoneSweepLookback = input.int(5, "Колко предишни свещи трябва да бъдат обрани", minval = 2, maxval = 8, group = g2)
zoneImpulseATR = input.float(1.2, "Минимална сила на импулса (ATR)", minval = 0.4, maxval = 5.0, step = 0.1, group = g2)
maxZonesPerTf = input.int(4, "Максимум зони на таймфрейм", minval = 1, maxval = 10, group = g2)
zoneDeleteTests = input.int(3, "Премахни зоната след N отделни теста", minval = 1, maxval = 6, group = g2)
opportunityMinScore = input.int(4, "Минимална сила за надпис „СИЛНА ЗОНА“", minval = 3, maxval = 7, group = g2)

// ═══════════════════════════════════════════════════════════════════════════
// 3 · ЛИКВИДНОСТ
// ═══════════════════════════════════════════════════════════════════════════
g3 = "3 · ЛИКВИДНОСТ И ОБИРАНЕ НА СТОПОВЕ"
showLiquidity = input.bool(true, "Показвай ликвидност над върхове / под дъна", group = g3)
showSweepMarkers = input.bool(true, "Маркер при обиране на ликвидност", group = g3)
liquidityPivot = input.int(5, "Колко свещи оформят важен връх/дъно", minval = 2, maxval = 25, group = g3)
liquidityTolerancePct = input.float(0.06, "Допустима разлика между равните върхове/дъна (%)", minval = 0.01, maxval = 1.0, step = 0.01, group = g3)
maxLiquidityEachSide = input.int(5, "Максимум активни нива от вид", minval = 1, maxval = 12, group = g3)
sweepFreshBars = input.int(12, "Колко свещи свипът остава актуален", minval = 2, maxval = 100, group = g3)

// ═══════════════════════════════════════════════════════════════════════════
