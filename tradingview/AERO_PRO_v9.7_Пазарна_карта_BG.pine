structurePivot = input.int(6, "Колко свещи оформят структурен връх/дъно", minval = 2, maxval = 30, group = g5)
showRetest = input.bool(true, "Показвай успешен/неуспешен ретест", group = g5)

// ═══════════════════════════════════════════════════════════════════════════
