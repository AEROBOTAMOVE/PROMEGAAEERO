showDailyFvg = input.bool(true, "Показвай и дневните дисбаланси", group = g4)
maxFvgPerTf = input.int(4, "Максимум FVG на таймфрейм", minval = 1, maxval = 10, group = g4)

// ═══════════════════════════════════════════════════════════════════════════
